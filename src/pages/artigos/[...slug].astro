---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = async () => {
  const artigos = await getCollection("artigos");
  return artigos.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, tags } = entry.data;

function fmt(date: Date) {
  return date.toLocaleDateString("pt-BR", { day: "2-digit", month: "long", year: "numeric" });
}
---

<Layout title={`${title} — Rayson Rodrigues`} description={description}>
  <main class="article">
    <p class="kicker">
      artigo técnico &middot; {fmt(pubDate)} &middot; {tags.join(" · ")}
    </p>

    <h1>{title}</h1>

    <div class="prose">
      <Content />
    </div>

    <p class="back"><a href="/artigos/">&larr; todos os artigos</a></p>
  </main>
</Layout>

<style>
  .article {
    max-width: 680px;
    margin: 0 auto;
    padding: clamp(48px, 8vh, 96px) 24px 96px;
  }

  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 18px;
  }

  h1 {
    font-family: var(--mincho);
    font-size: clamp(2rem, 5vw, 2.9rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    margin: 0 0 36px;
    letter-spacing: -0.01em;
  }

  .prose {
    color: var(--ink-2);
    font-size: 1.02rem;
    line-height: 1.8;
  }

  .prose :global(p) {
    margin: 0 0 20px;
  }

  .prose :global(p:first-child) {
    font-size: 1.1rem;
    color: var(--ink-3);
    font-family: var(--mono);
    line-height: 1.7;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(h2) {
    font-family: var(--mincho);
    font-size: 1.32rem;
    font-weight: 600;
    color: var(--ink);
    margin: 52px 0 14px;
    padding-top: 18px;
    border-top: 1px solid var(--hairline);
  }

  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.86em;
    background: var(--paper-tint);
    border-radius: 3px;
    padding: 1px 5px;
    color: var(--ink);
  }

  .prose :global(pre) {
    background: var(--paper-tint);
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 16px 18px;
    overflow-x: auto;
    margin: 22px 0 26px;
    line-height: 1.55;
  }

  .prose :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.82rem;
    color: var(--ink-2);
  }

  .prose :global(ul) {
    margin: 0 0 20px;
    padding-left: 22px;
  }

  .prose :global(li) {
    margin-bottom: 10px;
  }

  .prose :global(li::marker) {
    color: var(--seal);
  }

  .prose :global(a) {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--seal);
    transition: color 0.2s ease;
  }

  .prose :global(a:hover) {
    color: var(--seal);
  }

  .back {
    margin-top: 40px;
    font-family: var(--mono);
    font-size: 0.82rem;
  }
</style>
