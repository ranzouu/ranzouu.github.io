---
import { projects } from "../data/projects";
const span = ["t1", "t2", "t3", "t4", "t5"];
---
<section class="work reveal" id="trabalhos">
  <div class="sec-head">
    <h2 class="sec-title">trabalhos</h2>
    <span class="hint">passe o mouse: os tiles abrem</span>
  </div>
  <div class="bento">
    {projects.map((p, i) => (
      <a href={p.href} rel="noopener" class={`tile ${span[i]}`}>
        {i === 0 && <div class="spark" aria-hidden="true"></div>}
        <p class="tag">{p.stack}</p>
        <h3>{p.name}</h3>
        <p class="desc">
          {p.description}
        </p>
      </a>
    ))}
  </div>
</section>

<style>
  .work {
    padding-block: var(--space-xl);
  }

  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
    margin-bottom: var(--space-m);
  }

  .hint {
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .bento {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: 140px;
    gap: 14px;
  }

  .tile {
    border: 1px solid var(--hairline);
    border-radius: var(--radius);
    padding: 22px;
    background: var(--bg-raise);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    text-decoration: none;
    transition: border-color 0.35s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* tiles de 1 row: conteúdo no topo, o vazio fica embaixo (leitura natural) */
  .t3, .t4, .t5 {
    justify-content: flex-start;
  }

  .tile:hover,
  .tile:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translateY(-4px);
  }

  .tile h3 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--dim);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 0.4rem;
  }

  /* tile ATIVO: hover revela a camada de descrição */
  .desc {
    position: absolute;
    inset: 0;
    padding: 22px;
    background: linear-gradient(180deg, transparent 0%, var(--bg-raise) 38%);
    opacity: 0;
    translate: 0 14px;
    transition: opacity 0.4s, translate 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    font-size: 0.86rem;
    color: var(--dim);
    line-height: 1.55;
    margin: 0;
    pointer-events: none;
  }

  .tile:hover .desc,
  .tile:focus-visible .desc {
    opacity: 1;
    translate: 0 0;
  }

  /* rhythm: 7+5 / 4+4+4 */
  .t1 { grid-column: span 7; grid-row: span 2; }
  .t2 { grid-column: span 5; grid-row: span 2; }
  .t3 { grid-column: span 4; }
  .t4 { grid-column: span 4; }
  .t5 { grid-column: span 4; }

  /* sparkline decorativa só no tile destaque */
  .spark {
    margin: 0 0 12px;
    height: 46px;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-s);
    background:
      repeating-linear-gradient(90deg, transparent 0 18px, var(--hairline) 18px 19px),
      linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 25%, transparent));
    position: relative;
    overflow: hidden;
  }

  .spark::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -30%;
    width: 30%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--accent) 50%, transparent), transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .spark::after {
      animation: sweep 3.2s ease-in-out infinite;
    }
    @keyframes sweep {
      60%, 100% { left: 110%; }
    }
  }

  @media (max-width: 820px) {
    .bento {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: 120px;
    }
    .t1 { grid-column: span 6; grid-row: span 2; }
    .t2 { grid-column: span 6; grid-row: span 2; }
    .t3, .t4 { grid-column: span 3; }
    .t5 { grid-column: span 6; }
    /* touch: descrição sempre visível (hover não existe) */
    .desc {
      position: static;
      opacity: 1;
      translate: none;
      background: none;
      padding: 0;
      margin-top: 0.5rem;
    }
  }
</style>
