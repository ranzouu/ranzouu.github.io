---
import { projects } from "../data/projects";

const kanjiNumbers = ["一", "二", "三"];
---

<section class="projects glass-block reveal" id="projetos">
  <div class="head">
    <span class="kanji" aria-hidden="true">終</span>
    <div>
      <h2 class="title">projetos finalizados</h2>
      <p class="sub">concluídos, entregues e públicos</p>
    </div>
  </div>

  <div class="list">
    {projects.map((p, i) => (
      <article class="panel">
        <span class="index-kanji" aria-hidden="true">{kanjiNumbers[i]}</span>
        <div class="content">
          <a href={p.href} target="_blank" rel="noopener noreferrer" class="link">
            <h3 class="name">{p.name} <span class="arrow">↗</span></h3>
          </a>
          <p class="stack">{p.stack.toLowerCase()}</p>
          <p class="desc">{p.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .projects {
    margin-block: var(--space-m);
    padding: clamp(1.8rem, 4vw, 3rem);
  }

  .head {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    margin-bottom: 2rem;
  }

  .kanji {
    font-size: 2.2rem;
    color: var(--seal);
    opacity: 0.8;
    line-height: 1;
  }

  .title {
    font-family: var(--mincho);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .sub {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    margin-top: 0.3rem;
  }

  .list {
    border-top: 1px solid var(--hairline);
  }

  .panel {
    padding-block: clamp(2.2rem, 5vh, 3.5rem);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: clamp(48px, 7vw, 72px) 1fr;
    gap: clamp(1.4rem, 3vw, 2.5rem);
    align-items: baseline;
    transition: background-color 0.4s ease;
  }

  .panel:last-child {
    border-bottom: 0;
  }

  .index-kanji {
    font-family: var(--mincho);
    font-size: clamp(2rem, 3.6vw, 2.8rem);
    color: var(--ink-3);
    line-height: 1;
    user-select: none;
    transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .panel:hover .index-kanji {
    color: var(--seal);
  }

  .link {
    display: inline-block;
    text-decoration: none;
  }

  .name {
    font-family: var(--mincho);
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--ink);
    transition: color 0.4s ease;
  }

  .name .arrow {
    font-family: var(--mono);
    font-size: 0.85em;
    opacity: 0;
    display: inline-block;
    translate: -6px 3px;
    transition: opacity 0.4s ease, translate 0.4s ease;
  }

  .panel:hover .name {
    color: var(--seal);
  }

  .panel:hover .name .arrow {
    opacity: 1;
    translate: 0 0;
  }

  .stack {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--ink-3);
    margin-top: 0.8rem;
    text-transform: lowercase;
  }

  .desc {
    margin-top: 1.2rem;
    max-width: 52ch;
    color: var(--ink-2);
    line-height: 2;
    font-size: 1rem;
  }

  @media (max-width: 640px) {
    .panel {
      grid-template-columns: 40px 1fr;
      gap: 1.1rem;
      padding-block: 1.8rem;
    }
  }
</style>
