---
import { projects } from "../data/projects";

const kanjiNumbers = ["一", "二", "三", "四", "五"];
---

<!-- Traço de pincelada única horizontal no topo dos trabalhos -->
<svg class="brush-stroke" viewBox="0 0 880 46" preserveAspectRatio="none" aria-hidden="true">
  <defs>
    <filter id="brush-h">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.02 0.11"
        numOctaves="4"
        seed="3"
        result="noise"
      />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="9" />
    </filter>
  </defs>
  <g filter="url(#brush-h)">
    <path
      d="M 12 24 C 220 15, 660 14, 868 22"
      fill="none"
      stroke="#1c1913"
      stroke-width="3.2"
      stroke-linecap="round"
      opacity="0.65"
    />
    <path
      d="M 64 28 C 300 21, 600 18, 816 25"
      fill="none"
      stroke="#1c1913"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.3"
    />
  </g>
</svg>

<section class="works" id="trabalhos">
  <div class="sec-meta reveal">
    <span class="sec-label">trabalhos selecionados</span>
  </div>

  <div class="work-list">
    {projects.map((p, i) => (
      <article class="work-panel reveal">
        <span class="index-kanji" aria-hidden="true">{kanjiNumbers[i]}</span>
        
        <div class="work-content">
          <a href={p.href} target="_blank" rel="noopener noreferrer" class="work-link">
            <h3 class="w-name">
              {p.name}
              <span class="arrow" aria-hidden="true"> ↗</span>
            </h3>
          </a>
          <p class="w-stack">{p.stack.toLowerCase()}</p>
          <p class="w-desc">{p.description}</p>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .brush-stroke {
    display: block;
    width: 100%;
    height: 38px;
    margin-block: var(--space-s) var(--space-m);
    opacity: 0.8;
  }

  .works {
    padding-bottom: var(--space-l);
  }

  .sec-meta {
    margin-bottom: var(--space-m);
  }

  .sec-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: var(--ink-3);
    text-transform: uppercase;
  }

  .work-list {
    border-top: 1px solid var(--hairline);
  }

  .work-panel {
    padding-block: clamp(72px, 10vh, 120px);
    border-bottom: 1px solid var(--hairline);
    display: grid;
    grid-template-columns: clamp(56px, 8vw, 88px) 1fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: baseline;
    transition: background-color 0.4s ease;
  }

  .index-kanji {
    font-family: var(--mincho);
    font-size: clamp(2.2rem, 4vw, 3rem);
    color: var(--ink-3);
    line-height: 1;
    user-select: none;
    transition: color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Hover no painel: acende o kanji em vermelhão cinábrio */
  .work-panel:hover .index-kanji {
    color: var(--seal);
  }

  .work-link {
    display: inline-block;
  }

  .w-name {
    font-family: var(--mincho);
    font-size: clamp(1.8rem, 3.8vw, 2.7rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
    transition: color 0.4s ease;
  }

  .w-name .arrow {
    font-family: var(--mono);
    font-size: 0.9em;
    opacity: 0;
    display: inline-block;
    translate: -6px 4px;
    transition: opacity 0.4s ease, translate 0.4s ease;
  }

  .work-panel:hover .w-name {
    color: var(--seal);
  }

  .work-panel:hover .w-name .arrow {
    opacity: 1;
    translate: 0 0;
  }

  .w-stack {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    color: var(--ink-3);
    margin-top: 1rem;
    text-transform: lowercase;
  }

  .w-desc {
    margin-top: 1.5rem;
    max-width: 52ch;
    color: var(--ink-2);
    line-height: 2;
    font-size: 1.02rem;
    font-weight: 400;
  }

  @media (max-width: 640px) {
    .work-panel {
      grid-template-columns: 44px 1fr;
      gap: 20px;
      padding-block: 56px;
    }
  }
</style>
