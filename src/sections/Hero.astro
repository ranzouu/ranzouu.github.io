---
---
<section class="hero" id="top">
  <!-- Ensō-janela: o círculo recorta a arte do fundo em vez de competir com ela -->
  <div class="enso-window" aria-hidden="true">
    <svg viewBox="0 0 400 400">
      <defs>
        <!-- anel de tinta com borda de pincel irregular -->
        <filter id="brush-enso">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.035 0.09"
            numOctaves="4"
            seed="7"
            result="noise"
          />
          <feDisplacementMap in="SourceGraphic" in2="noise" scale="16" />
        </filter>
        <!-- a máscara: dentro do anel, a arte do fundo aparece -->
        <mask id="enso-cut">
          <path
            d="M 200 52 A 148 148 0 1 1 199 52 Z"
            fill="#fff"
            filter="url(#brush-enso)"
          />
        </mask>
      </defs>
      <!-- aro: um traço fino em cinábrio, como lacre ao redor da janela -->
      <circle
        cx="200"
        cy="200"
        r="148"
        fill="none"
        stroke="#b5382a"
        stroke-width="3"
        opacity="0.7"
        filter="url(#brush-enso)"
      />
      <!-- janela: mostra o fundo NITIDO dentro do círculo (fora dele, o vidro escurece) -->
      <circle cx="200" cy="200" r="144" fill="rgba(243,239,230,0.78)" />
    </svg>
  </div>

  <div class="hero-inner">
    <p class="kicker">fortaleza, brasil &middot; dois mil e vinte e seis</p>

    <h1 id="headline">Rayson Rodrigues.</h1>

    <p class="hero-role">
      Estudante de <em>ADS</em> · Python · GitHub · Automação · Background em Educação Física.
    </p>

    <div class="hero-links">
      <a href="#commits">últimos commits</a>
      <a href="#projetos">projetos finalizados</a>
      <a href="#contato">contato</a>
    </div>

    <svg class="hanko" viewBox="0 0 52 52" aria-label="Selo Hanko de Rayson Rodrigues">
      <rect x="2" y="2" width="48" height="48" rx="6" fill="#b5382a" />
      <text
        x="26"
        y="36"
        font-family="Shippori Mincho, Georgia, serif"
        font-size="28"
        font-weight="600"
        fill="#f3efe6"
        text-anchor="middle"
      >R</text>
    </svg>
  </div>
</section>

<style>
  .hero {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-block: clamp(48px, 10vh, 110px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero {
      animation: heroFade 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes heroFade {
      from {
        opacity: 0;
        translate: 0 18px;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
  }

  .hero-inner {
    background: var(--glass-strong);
    backdrop-filter: blur(14px) saturate(1.05);
    -webkit-backdrop-filter: blur(14px) saturate(1.05);
    border: 1px solid var(--glass-border);
    border-radius: 4px;
    padding: clamp(2rem, 4.5vw, 3.5rem);
    max-width: 620px;
    position: relative;
    z-index: 1;
    overflow: hidden;
  }

  @supports not (backdrop-filter: blur(1px)) {
    .hero-inner {
      background: rgba(243, 239, 230, 0.97);
    }
  }

  /* Ensō: arte de fundo DENTRO do painel, atrás do texto (z-0),
     ancorado no canto direito onde não há texto */
  .enso-window {
    position: absolute;
    right: -70px;
    top: -60px;
    width: clamp(240px, 32vw, 380px);
    aspect-ratio: 1;
    z-index: 0;
    opacity: 0.9;
    pointer-events: none;
  }

  .enso-window svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .kicker {
    position: relative;
    z-index: 1;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    color: var(--ink-3);
    margin: 0 0 1.8rem;
    text-transform: uppercase;
  }

  h1 {
    position: relative;
    z-index: 1;
    font-family: var(--mincho);
    font-weight: 500;
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  .hero-role {
    position: relative;
    z-index: 1;
    margin-top: 1.1rem;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    color: var(--ink-2);
    font-weight: 400;
    line-height: 1.5;
  }

  .hero-role em {
    font-style: normal;
    color: var(--seal);
  }



  .hero-links {
    position: relative;
    z-index: 1;
    margin-top: 2.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 3.5vw, 36px);
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .hero-links a {
    padding-bottom: 4px;
    border-bottom: 1px solid var(--hairline);
    color: var(--ink-2);
    transition: border-color 0.4s ease, color 0.4s ease;
  }

  .hero-links a:hover {
    border-color: var(--seal);
    color: var(--seal);
  }

  .hanko {
    position: absolute;
    z-index: 2;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    width: 40px;
    opacity: 0.95;
    transition: transform 0.4s ease;
  }

  .hanko:hover {
    transform: rotate(-3deg) scale(1.05);
  }

  @media (max-width: 760px) {
    .enso-window {
      opacity: 0.4;
      right: -110px;
      width: 280px;
    }
    .hero-inner {
      padding: 1.6rem;
    }
    .hanko {
      position: static;
      margin-top: 2rem;
      display: block;
    }
  }
</style>
