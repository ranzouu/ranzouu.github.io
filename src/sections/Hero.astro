---
---
<section class="hero" id="top">
  <!-- Ensō: círculo de tinta zen desenhado em SVG com deformação de pincel real -->
  <svg class="enso-wrap" viewBox="0 0 400 400" aria-hidden="true">
    <defs>
      <filter id="brush-enso">
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.035 0.09"
          numOctaves="4"
          seed="7"
          result="noise"
        />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="14" />
      </filter>
    </defs>
    <g filter="url(#brush-enso)">
      <path
        d="M 330 105 A 138 142 0 1 0 336 118"
        fill="none"
        stroke="#1c1913"
        stroke-width="14"
        stroke-linecap="round"
        opacity="0.13"
      />
      <path
        d="M 322 96 A 136 140 0 0 0 268 54"
        fill="none"
        stroke="#1c1913"
        stroke-width="9"
        stroke-linecap="round"
        opacity="0.09"
      />
      <path
        d="M 345 190 A 128 130 0 0 1 336 118"
        fill="none"
        stroke="#1c1913"
        stroke-width="5"
        stroke-linecap="round"
        opacity="0.06"
      />
    </g>
  </svg>

  <p class="kicker">portfólio &middot; dois mil e vinte e seis</p>
  
  <h1 id="headline">
    Personal trainer virando <em>dev</em>.<br />Construo sistemas.
  </h1>

  <p class="hero-sub">
    Bots de trading, apps iOS e automações. A mentalidade é a mesma do treino:
    <b>consistência, carga progressiva e teste antes de confiança</b>.
  </p>

  <div class="hero-bottom">
    <div class="hero-links">
      <a href="#trabalhos">trabalhos</a>
      <a href="#historia">história</a>
      <a href="#ferramentas">stack</a>
      <a href="#contato">contato</a>
    </div>

    <!-- Hanko do Hero: selo vermelho de assinatura tradicional em cinábrio -->
    <svg class="hanko-hero" viewBox="0 0 52 52" aria-label="Selo Hanko de Rayson Rodrigues">
      <rect x="2" y="2" width="48" height="48" rx="6" fill="#b5382a" />
      <text
        x="26"
        y="36"
        font-family="Shippori Mincho, Georgia, serif"
        font-size="28"
        font-weight="600"
        fill="#f3efe6"
        text-anchor="middle"
      >R</text>
    </svg>
  </div>
</section>

<style>
  .hero {
    min-height: 88dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-block: clamp(48px, 8vh, 88px);
  }

  /* Animação suave inicial do Hero em CSS puro (LCP amigável) */
  @media (prefers-reduced-motion: no-preference) {
    .hero {
      animation: heroFade 1.2s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    @keyframes heroFade {
      from {
        opacity: 0;
        translate: 0 18px;
      }
      to {
        opacity: 1;
        translate: 0 0;
      }
    }
  }

  /* Ensō flutuando atrás do headline */
  .enso-wrap {
    position: absolute;
    right: clamp(-40px, 3vw, 30px);
    top: 45%;
    translate: 0 -50%;
    width: clamp(280px, 38vw, 480px);
    opacity: 0.95;
    pointer-events: none;
    z-index: 0;
  }

  .kicker {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    color: var(--ink-3);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    position: relative;
    z-index: 1;
  }

  h1 {
    font-family: var(--mincho);
    font-weight: 500;
    font-size: clamp(2.2rem, 5.2vw, 4.2rem);
    line-height: 1.22;
    letter-spacing: 0.01em;
    max-width: 16ch;
    text-wrap: balance;
    position: relative;
    z-index: 1;
  }

  h1 em {
    font-style: normal;
    color: var(--seal);
  }

  .hero-sub {
    margin-top: 1.6rem;
    max-width: 46ch;
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--ink-2);
    font-weight: 400;
    position: relative;
    z-index: 1;
  }

  .hero-sub b {
    font-weight: 600;
    color: var(--ink);
  }

  .hero-bottom {
    margin-top: clamp(2rem, 5vh, 3.2rem);
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    position: relative;
    z-index: 1;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(18px, 3.5vw, 36px);
    font-family: var(--mono);
    font-size: 0.82rem;
  }

  .hero-links a {
    padding-bottom: 4px;
    border-bottom: 1px solid var(--hairline);
    color: var(--ink-2);
    transition: border-color 0.4s ease, color 0.4s ease;
  }

  .hero-links a:hover {
    border-color: var(--seal);
    color: var(--seal);
  }

  /* Hanko do Hero alinhado na base */
  .hanko-hero {
    width: 44px;
    height: 44px;
    opacity: 0.95;
    flex-shrink: 0;
    transition: transform 0.4s ease, opacity 0.4s ease;
    cursor: default;
  }

  .hanko-hero:hover {
    transform: rotate(-3deg) scale(1.05);
  }

  @media (max-width: 760px) {
    .enso-wrap {
      opacity: 0.45;
      right: -60px;
      width: 290px;
    }

    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 2rem;
    }
  }
</style>
