---
---
<section class="hero" id="top">
  <p class="kicker">personal trainer virando dev · fortaleza, br</p>
  <h1 id="headline"><span class="w">Treino</span> a disciplina.<br />Construo <span class="accent w">sistemas.</span></h1>
  <p class="hero-sub">
    Bots de trading, apps iOS e automações. A mentalidade é a mesma do treino:
    <b>consistência, carga progressiva e teste antes de confiança</b>.
  </p>
  <div class="hero-meta">
    <span>5 projetos ativos</span>
    <span>122 testes verdes</span>
    <span>2 plataformas apple</span>
  </div>
  <div class="hero-cta">
    <a class="btn btn-primary" href="#trabalhos">ver projetos</a>
    <a class="btn btn-ghost" href="#contato">fale comigo</a>
  </div>
</section>

<style>
  .hero {
    min-height: 92dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-xl);
  }

  .kicker {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    margin: 0 0 var(--space-s);
    letter-spacing: 0.02em;
  }

  .kicker::before {
    content: "> ";
    opacity: 0.6;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10.5vw, 8.6rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
    max-width: 15ch;
    margin: 0;
  }

  h1 .accent {
    color: var(--accent);
  }

  /* cinética pontual: peso variável no hover; reduced-motion = estático */
  h1 .w {
    font-variation-settings: "wght" 700;
  }

  @media (prefers-reduced-motion: no-preference) {
    h1 .w {
      transition: font-variation-settings 0.5s ease;
    }
    h1:hover .w {
      font-variation-settings: "wght" 300;
    }
  }

  .hero-sub {
    margin: var(--space-s) 0 0;
    max-width: 50ch;
    color: var(--dim);
    line-height: 1.6;
    font-weight: 300;
  }

  .hero-sub b {
    color: var(--fg);
    font-weight: 500;
  }

  .hero-meta {
    margin-top: var(--space-m);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--dim);
    letter-spacing: 0.06em;
  }

  .hero-meta span::before {
    content: "◆ ";
    color: var(--accent);
    font-size: 8px;
    vertical-align: 2px;
  }

  .hero-cta {
    margin-top: var(--space-m);
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero-cta a {
    text-decoration: none;
  }
</style>

<script>
  // Headline criptográfico: repouso = caracteres codificados;
  // hover (ou foco via teclado) revela o texto real letra a letra.
  // reduced-motion = texto direto, sem scramble.
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const h1 = document.getElementById("headline");
  if (h1 && !reduce) {
    const words = [...h1.querySelectorAll(".w")];
    const originals = words.map((el) => el.textContent);
    const glyphs = "#$%&/()<>[]{}=+*";
    let raf = null;
    let hover = false;

    const scramble = (progress) => {
      words.forEach((el, wi) => {
        const txt = originals[wi];
        el.textContent = txt
          .split("")
          .map((c, i) =>
            i < progress * txt.length ? c : glyphs[(Math.random() * glyphs.length) | 0]
          )
          .join("");
      });
    };

    const play = (to, from = 0, ms = 900) => {
      if (raf) cancelAnimationFrame(raf);
      const t0 = performance.now();
      (function tick(now) {
        const p = Math.min((now - t0) / ms, 1);
        scramble(from + (to - from) * p);
        if (p < 1) raf = requestAnimationFrame(tick);
      })(t0);
    };

    // estado de repouso: codificado
    scramble(0);

    h1.addEventListener("pointerenter", () => {
      hover = true;
      play(1);
    });
    h1.addEventListener("pointerleave", () => {
      hover = false;
      play(0);
    });
    h1.addEventListener("focusin", () => play(1));
    h1.addEventListener("focusout", () => play(0));

    // primeira visita: decodifica como chamada, depois volta a codificar
    setTimeout(() => {
      play(1, 0, 700);
      setTimeout(() => {
        if (!hover) play(0, 1, 500);
      }, 1600);
    }, 300);
  }
</script>
