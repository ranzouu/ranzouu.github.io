---
const groups = [
  { title: "linguagens", items: ["Python", "Swift"] },
  {
    title: "mobile",
    items: ["SwiftUI", "watchOS", "HealthKit", "WidgetKit", "XcodeGen"],
  },
  {
    title: "dados e bots",
    items: ["pandas", "ccxt", "Streamlit", "pytest", "SQLAlchemy", "SQLite"],
  },
];
---
<section class="stack reveal" id="ferramentas">
  <h2 class="sec-title">stack</h2>
  <div class="rows">
    {groups.map((g) => (
      <div class="row">
        <span class="lbl">{g.title}</span>
        <ul>
          {g.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .stack {
    padding-block: var(--space-xl);
  }

  .rows {
    border-top: 1px solid var(--hairline);
  }

  .row {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-s);
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--hairline);
    align-items: baseline;
  }

  .lbl {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--dim);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-size: 1.15rem;
    font-weight: 300;
  }

  li {
    transition: color 0.25s;
    cursor: default;
  }

  @media (prefers-reduced-motion: no-preference) {
    li {
      transition: color 0.25s, font-variation-settings 0.25s;
    }
    li:hover {
      color: var(--accent);
      font-variation-settings: "wght" 600;
    }
  }

  @media (max-width: 820px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
