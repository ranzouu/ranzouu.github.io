---
const groups = [
  {
    title: "linguagens",
    items: ["Python", "Swift"],
  },
  {
    title: "mobile",
    items: ["SwiftUI", "watchOS", "HealthKit", "WidgetKit", "XcodeGen"],
  },
  {
    title: "dados e bots",
    items: ["pandas", "ccxt", "Streamlit", "pytest", "SQLAlchemy", "SQLite"],
  },
];
---

<section class="stack glass-block" id="ferramentas">
  <div class="sec-meta reveal">
    <span class="sec-label">instrumentos e ferramentas</span>
  </div>

  <div class="stack-rows">
    {groups.map((g, i) => (
      <div class="stack-row reveal" style={`--reveal-delay: calc(${i} * var(--motion-stagger))`}>
        <span class="s-label">{g.title}</span>
        <div class="s-items">
          {g.items.map((item, idx) => (
            <>
              <span class="item">{item}</span>
              {idx < g.items.length - 1 && <span class="dot" aria-hidden="true"> · </span>}
            </>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .stack {
  margin-block: var(--space-m);
  padding: clamp(1.8rem, 4vw, 3rem);
}

  .sec-meta {
    margin-bottom: var(--space-s);
  }

  .sec-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: var(--ink-3);
    text-transform: uppercase;
  }

  .stack-rows {
    border-top: 1px solid var(--hairline);
  }

  .stack-row {
    display: grid;
    grid-template-columns: clamp(120px, 18vw, 160px) 1fr;
    gap: 24px;
    padding-block: 26px;
    border-bottom: 1px solid var(--hairline);
    align-items: baseline;
  }

  /* Resposta tátil: a linha se assenta levemente ao aproximar do cursor */
  .stack-row:hover {
    transform: translate3d(0, -2px, 0);
  }

  .s-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    text-transform: uppercase;
  }

  .s-items {
    font-family: var(--mincho);
    font-size: 1.15rem;
    line-height: 2.2;
    color: var(--ink-2);
  }

  .item {
    transition: color var(--motion-fast) var(--motion-easing);
    cursor: default;
  }

  .item:hover {
    color: var(--seal);
  }

  .dot {
    color: var(--hairline);
    font-family: var(--mono);
    user-select: none;
  }

  @media (max-width: 640px) {
    .stack-row {
      grid-template-columns: 1fr;
      gap: 8px;
      padding-block: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-row:hover {
      transform: none;
    }
  }
</style>
