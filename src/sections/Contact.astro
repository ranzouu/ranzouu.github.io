---
const email = "rayson.severiano@gmail.com";
const github = "https://github.com/ranzouu";
const linkedin = "https://www.linkedin.com/in/rayson-severiano-a4a576140";
---
<footer class="contact reveal" id="contato">
  <p class="big">
    Tem um projeto?<br />
    <a href={`mailto:${email}`}>Vamos conversar</a>
  </p>
  <div class="meta">
    <a href={github} rel="me noopener" target="_blank">github/ranzouu</a>
    <a href={linkedin} rel="me noopener" target="_blank">linkedin/rayson-severiano</a>
    <span>fortaleza, brasil</span>
  </div>
</footer>

<style>
  .contact {
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-xl) var(--space-m);
  }

  .big {
    font-size: clamp(2.4rem, 7vw, 5.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.02;
    margin: 0 0 var(--space-l);
  }

  .big a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 2px solid var(--hairline);
    transition: border-color 0.3s;
  }

  .big a:hover {
    border-color: var(--accent);
  }

  .meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--dim);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }

  .meta a:hover {
    color: var(--accent);
  }
</style>
