---
const email = "rayson.severiano@gmail.com";
const github = "https://github.com/ranzouu";
const linkedin = "https://www.linkedin.com/in/rayson-severiano-a4a576140";
---

<footer class="contact glass-block reveal" id="contato">
  <div class="foot-main">
    <p class="foot-cta">
      Tem um projeto?<br />
      <a href={`mailto:${email}`}>Vamos conversar</a>
    </p>

    <!-- Hanko do Rodapé: selo de conclusão da obra -->
    <svg class="hanko-foot" viewBox="0 0 52 52" aria-label="Selo Hanko de Rayson Rodrigues">
      <rect x="2" y="2" width="48" height="48" rx="6" fill="#b5382a" />
      <text
        x="26"
        y="36"
        font-family="Shippori Mincho, Georgia, serif"
        font-size="28"
        font-weight="600"
        fill="#f3efe6"
        text-anchor="middle"
      >R</text>
    </svg>
  </div>

  <div class="foot-meta">
    <a href={github} rel="me noopener noreferrer" target="_blank">github/ranzouu</a>
    <a href={linkedin} rel="me noopener noreferrer" target="_blank">linkedin/rayson-severiano</a>
    <span>fortaleza, brasil</span>
  </div>
</footer>

<style>
  .contact {
  margin-block: var(--space-m) var(--space-l);
  padding: clamp(1.8rem, 4vw, 3rem);
}

  .foot-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
  }

  .foot-cta {
    font-family: var(--mincho);
    font-size: clamp(2rem, 4.8vw, 3.4rem);
    font-weight: 500;
    line-height: 1.35;
    max-width: 16ch;
    color: var(--ink);
  }

  .foot-cta a {
    color: var(--seal);
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s ease, opacity 0.4s ease;
  }

  .foot-cta a:hover {
    border-color: var(--seal);
    opacity: 0.85;
  }

  .hanko-foot {
    width: 46px;
    height: 46px;
    opacity: 0.95;
    flex-shrink: 0;
    margin-bottom: 8px;
    transition: transform 0.4s ease;
    cursor: default;
  }

  .hanko-foot:hover {
    transform: rotate(3deg) scale(1.06);
  }

  .foot-meta {
    margin-top: clamp(48px, 8vh, 80px);
    display: flex;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: clamp(20px, 4vw, 48px);
    font-family: var(--mono);
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }

  .foot-meta a {
    transition: color 0.3s ease;
  }

  .foot-meta a:hover {
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .foot-main {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
